# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Mapbox Configuration
# Get a free access token at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=your_mapbox_access_token_here
# ios: mapbox://styles/mapbox/streets-v12
VITE_MAPBOX_STYLE=mapbox://styles/khanhlegood1/cmugqp3pj002z01s3dw9s9r37

# Google Maps Configuration (optional — only needed for the "Street View"
# imagery option when creating/editing a memory)
# Get a key at https://console.cloud.google.com/google/maps-apis and enable
# the "Maps Embed API"
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# AI backend (server-side only — never prefix with VITE_, never expose to
# the browser). Used by:
#   - api/video-to-learning.js  ("Tạo trang học tập từ video")
#   - api/learning-game.js      ("Tạo game giáo dục")
# Both functions try Groq first (free tier: https://console.groq.com/keys)
# and fall back to Gemini when Groq fails or a video has no captions.
GROQ_API_KEY=your_groq_api_key_here
# Free tier key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
